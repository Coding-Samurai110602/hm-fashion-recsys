# Copy to .env and customize. Real .env is gitignored.

# Directory containing the serving bundle (must contain manifest.json).
# docker compose uses this to mount the bundle read-only into the api container.
# Use ./artifacts/bundle_synthetic for the lightweight CI/dev bundle.
BUNDLE_DIR=./artifacts/bundle_week104

# Path to the bundle inside the container (used by the api process).
BUNDLE_PATH=/bundle

# SQLite database file for user-created profiles.
# In the docker-compose stack this resolves to /data/profiles.db (named volume).
# Set to /tmp/profiles_e2e.db for isolated e2e test runs.
SQLITE_DB_PATH=/data/profiles.db

# Comma-separated allowed CORS origins.
# When using docker compose, the web container is on port 8080.
CORS_ORIGINS=http://localhost:8080

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# LRU cache size (number of recommendation responses cached in memory)
CACHE_SIZE=512

# Maximum custom history items per /recommendations/custom request
MAX_CUSTOM_HISTORY=200
