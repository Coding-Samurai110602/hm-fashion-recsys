# Copy to .env and customize. Real .env is gitignored.

# Path to the serving bundle directory (must contain manifest.json)
BUNDLE_PATH=/bundle

# Comma-separated allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging level
LOG_LEVEL=INFO

# LRU cache size (number of recommendation responses cached)
CACHE_SIZE=512

# Maximum custom history items per /recommendations/custom request
MAX_CUSTOM_HISTORY=200
