            },
            "type": "array",
            "title": "Recent History"
          }
        },
        "type": "object",
        "required": [
          "customer_idx",
          "customer_id",
          "age_bucket",
          "n_purchases_all_time",
          "n_purchases_last_4w",
          "recent_history"
        ],
        "title": "CustomerProfile"
      },
      "ExplainResult": {
        "properties": {
