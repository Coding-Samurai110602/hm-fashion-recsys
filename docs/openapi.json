          "product_type",
          "colour",
          "department"
        ],
        "title": "ArticleMeta"
      },
      "CustomHistoryItem": {
        "properties": {
          "article_id": {
            "type": "string",
            "title": "Article Id"
          },
          "t_dat": {
            "type": "string",
