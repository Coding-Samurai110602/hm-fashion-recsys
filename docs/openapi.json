          }
        },
        "type": "object",
        "required": [
          "article_id",
          "t_dat"
        ],
        "title": "CustomHistoryItem"
      },
      "CustomRecommendRequest": {
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/CustomHistoryItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "history"
        ],
        "title": "CustomRecommendRequest"
      },
      "CustomerProfile": {
